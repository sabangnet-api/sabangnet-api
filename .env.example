# ── 사방넷 API 호스트 (기본값: 운영) ───────────────────────────
# 개발자센터: https://developer.sabangnet.co.kr  (가이드 문서: /docs/)
#   운영     : https://api.sabangnet.co.kr
#   샌드박스 : https://sandbox.sabangnet.co.kr
# ⚠️ 운영 호스트로 실행하면 상품 등록·발주 등 쓰기 API가 실데이터에 반영됩니다.
SABANGNET_API_SERVER=https://api.sabangnet.co.kr
SABANGNET_API_BASE=https://api.sabangnet.co.kr/v3/sb

# ── OAuth2 토큰 발급 URL ──────────────────────────────────────
TOKEN_URL=https://api.sabangnet.co.kr/oauth2/token

# ── 앱 Client 정보 (개발자센터 > 앱 관리 > 앱 등록 후 발급) ───
CLIENT_ID=
SECRET_KEY=
CLIENT_TYPE=SB_APP

# ── 서비스 계정 ID (호출 대상 고객사의 서비스코드, 예: mw000001) ─
SVC_ACNT_ID=

# ── Bearer Token 직접 지정 (설정 시 토큰 발급 과정 생략) ────────
BEARER_TOKEN=

# ── 풀필먼트(창고관리) API ────────────────────────────────────
# 주문관리와 동일 호스트 공유, 경로 접두사 /v3/sbf 로 구분
FULFILLMENT_API_BASE=https://api.sabangnet.co.kr/v3/sbf

# ── SSL 검증 ──────────────────────────────────────────────────
# 운영/샌드박스 게이트웨이가 TLS 1.3 에서 사내 CA 인증서를 제시하므로 기본은 false.
# 사내 CA를 신뢰하도록 구성했다면 true 로 설정
VERIFY_SSL=false
